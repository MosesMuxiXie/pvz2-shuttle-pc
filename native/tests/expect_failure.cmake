if(NOT DEFINED PROGRAM OR NOT DEFINED MODE OR NOT DEFINED INPUT OR NOT DEFINED EXPECTED)
    message(FATAL_ERROR "missing test arguments")
endif()
execute_process(COMMAND "${PROGRAM}" "${MODE}" "${INPUT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Expected exit 1, got ${result}; ${output}; ${error}")
endif()
if(NOT error MATCHES "${EXPECTED}")
    message(FATAL_ERROR "Missing diagnostic '${EXPECTED}': ${error}")
endif()
